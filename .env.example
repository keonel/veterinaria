# Copia este archivo como ".env" y cambia los valores. El archivo .env NO se sube a GitHub.

# Contraseñas de las cuentas iniciales (5 a 10 caracteres, una mayúscula y un número).
# Solo se usan la primera vez que se crea la base de datos.
ADMIN_PASSWORD=Admin1234
VENDEDOR_PASSWORD=Vende1234
CLIENTE_PASSWORD=Cliente123

# Clave compartida entre pedidos y catálogo para el endpoint interno de ventas
INTERNAL_API_KEY=local-cambiar-clave-interna-32-caracteres

# MySQL (Docker): una contraseña por base de datos
MYSQL_ROOT_PASSWORD=root-local-cambiar
DB_USUARIOS_PASSWORD=usuarios-local-cambiar
DB_CATALOGO_PASSWORD=catalogo-local-cambiar
DB_PEDIDOS_PASSWORD=pedidos-local-cambiar
DB_CITAS_PASSWORD=citas-local-cambiar

# Orígenes del frontend autorizados por CORS (separados por coma, sin espacios)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# true solo si el sitio se publica con HTTPS
COOKIE_SECURE=false
